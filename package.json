{
  "name": "dsh-auto-rerun",
  "version": "1.8.3",
  "description": "模型断连自动重跑：同一会话内守住当前模型一直重试直到跑通（免费模型易堵塞；退避封顶），只有订阅过期/key 失效这类死路报错才停；另可选回合级 followup 续跑与选模型重试（默认关），并在右侧栏提供运行状态与开关面板。Keep a turn alive across provider hiccups: retries the same model in-session until it succeeds, stops only on dead routes (expired subscription / bad key), with optional turn-level followup, model fallback and a right-sidebar panel.",
  "type": "module",
  "main": "index.js",
  "types": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "test/inject-shape.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "rerun",
    "disconnect",
    "network",
    "resilience",
    "model-fallback"
  ],
  "license": "MIT",
  "author": "good-saltfish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/good-saltfish/dsh-auto-rerun.git"
  },
  "homepage": "https://github.com/good-saltfish/dsh-auto-rerun#readme",
  "bugs": {
    "url": "https://github.com/good-saltfish/dsh-auto-rerun/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible"
      }
    }
  }
}
